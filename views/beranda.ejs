<!-- Dashboard Styles -->
<link rel="stylesheet" href="/css/dashboard.css" />

<div class="dashboard-container">
  <!-- Dashboard Header -->
  <div class="dashboard-header">
    <h1 class="dashboard-title">
      <i class="bi bi-speedometer2 me-2"></i>
      Dashboard Analytics
    </h1>
  </div>

  <!-- Loading Indicator -->
  <div id="dashboardLoader" class="dashboard-loader">
    <div class="loader-spinner"></div>
    <p>Loading dashboard data...</p>
  </div>

  <!-- Welcome Message -->
  <div class="welcome-section mb-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <div class="row align-items-center">
          <div class="col-md-8">
            <h4 class="mb-2">
              <i class="bi bi-person-circle me-2 text-primary"></i>
              Selamat Datang, <%= user.username %>!
            </h4>
            <p class="text-muted mb-0">Dashboard ini menampilkan statistik real-time dari laporan pimpinan. Data diperbarui otomatis setiap 30 detik untuk memberikan informasi terkini.</p>
          </div>
          <div class="col-md-4 text-end">
            <a href="/laporan" class="btn btn-primary btn-lg">
              <i class="bi bi-file-text me-2"></i>
              Kelola Laporan
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Dashboard Controls Card -->
  <div class="controls-section mb-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-3">
        <div class="row">
          <!-- Date Filters -->
          <div class="col-md-8">
            <div class="filter-section">
              <h6 class="mb-3">
                <i class="bi bi-calendar3 me-2"></i>
                Filter Periode
              </h6>
              <div class="filter-controls">
                <div class="filter-buttons mb-2">
                  <button type="button" class="btn btn-outline-primary btn-sm filter-btn active" data-filter="all">Semua Waktu</button>
                  <button type="button" class="btn btn-outline-primary btn-sm filter-btn" data-filter="daily">Harian</button>
                  <button type="button" class="btn btn-outline-primary btn-sm filter-btn" data-filter="weekly">Mingguan</button>
                  <button type="button" class="btn btn-outline-primary btn-sm filter-btn" data-filter="monthly">Bulanan</button>
                </div>
                <div class="date-picker-container">
                  <input type="date" id="dailyPicker" class="form-control form-control-sm date-picker" style="display: none" />
                  <input type="week" id="weeklyPicker" class="form-control form-control-sm date-picker" style="display: none" />
                  <input type="month" id="monthlyPicker" class="form-control form-control-sm date-picker" style="display: none" />
                </div>
              </div>
            </div>
          </div>

          <!-- Refresh Controls -->
          <div class="col-md-4">
            <div class="refresh-section">
              <h6 class="mb-3">
                <i class="bi bi-arrow-clockwise me-2"></i>
                Kontrol Data
              </h6>
              <div class="row g-2 align-items-center">
                <div class="col-auto">
                  <button id="refreshBtn" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-arrow-clockwise me-1"></i>
                    Refresh
                  </button>
                </div>
                <div class="col-auto">
                  <button id="toggleAutoRefresh" class="btn btn-outline-secondary btn-sm" title="Toggle Auto-refresh">
                    <i class="bi bi-pause-circle" id="autoRefreshIcon"></i>
                  </button>
                </div>
                <div class="col">
                  <div class="d-flex justify-content-end align-items-center">
                    <span id="refreshIndicator" class="refresh-indicator me-2"></span>
                    <small class="text-muted">
                      Terakhir: <span id="lastRefresh">-</span>
                    </small>
                  </div>
                </div>
              </div>
              <small class="text-muted mt-2">
                <i class="bi bi-clock me-1"></i>
                Auto-refresh setiap 30 detik
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="statistics-section mb-3">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-light">
        <h5 class="mb-0">
          <i class="bi bi-bar-chart me-2"></i>
          Statistik Laporan
        </h5>
      </div>
      <div class="card-body p-4">
        <div class="row">
          <div class="col-md-4">
            <div class="stat-item text-center">
              <div class="stat-number text-success" id="totalReports">-</div>
              <p class="stat-label">Total Laporan</p>
              <i class="bi bi-files stat-icon text-success"></i>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stat-item text-center">
              <div class="stat-number text-warning" id="recentReports">-</div>
              <p class="stat-label">Laporan Minggu Ini</p>
              <i class="bi bi-calendar-week stat-icon text-warning"></i>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stat-item text-center">
              <div class="stat-number text-danger" id="priorityReports">-</div>
              <p class="stat-label">Laporan Prioritas</p>
              <i class="bi bi-exclamation-triangle stat-icon text-danger"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Container -->
  <div class="charts-section">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-light">
        <h5 class="mb-0">
          <i class="bi bi-graph-up me-2"></i>
          Analisis Data Laporan
        </h5>
      </div>
      <div class="card-body p-4">
        <div class="charts-container">
          <!-- Bar Chart -->
          <div class="chart-card">
            <div class="chart-header">
              <h6 class="chart-title">Distribusi Berdasarkan Jenis Laporan</h6>
              <p class="chart-subtitle">Jumlah laporan per kategori</p>
            </div>
            <div class="chart-wrapper">
              <canvas id="barChart"></canvas>
            </div>
          </div>

          <!-- Pie Chart -->
          <div class="chart-card">
            <div class="chart-header">
              <h6 class="chart-title">Distribusi Berdasarkan Media</h6>
              <p class="chart-subtitle">Persentase per jenis media</p>
            </div>
            <div class="chart-wrapper">
              <canvas id="pieChart"></canvas>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0/dist/chartjs-plugin-datalabels.min.js"></script>

<!-- Dashboard JavaScript -->
<script src="/js/dashboard.js"></script>