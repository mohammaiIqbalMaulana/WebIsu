<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body>
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h4 class="mb-0">
                            <i class="bi bi-pencil-square me-2"></i><%= title %>
                        </h4>
                    </div>
                    <div class="card-body">
                        <% if (typeof messages !== 'undefined' && messages.error) { %>
                            <div class="alert alert-danger">
                                <i class="bi bi-exclamation-triangle me-2"></i><%= messages.error %>
                            </div>
                        <% } %>

                        <form action="/media/edit/<%= media.id %>" method="POST" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label for="nama_media" class="form-label">
                                    <i class="bi bi-card-text me-1"></i>Nama Media <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control" id="nama_media" name="nama_media"
                                       value="<%= media.nama_media %>" placeholder="Masukkan nama media online" required>
                                <div class="form-text">
                                    Nama media yang akan ditampilkan dalam daftar
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="bi bi-file-earmark me-1"></i>File Saat Ini
                                </label>
                                <% if (media.file_name && media.file_path) { %>
                                    <div class="border rounded p-3 bg-light">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-file-earmark-text me-2 text-primary" style="font-size: 1.5rem;"></i>
                                            <div class="flex-grow-1">
                                                <strong><%= media.file_name %></strong>
                                                <br>
                                                <small class="text-muted">
                                                    Ukuran: <%= media.file_size ? (media.file_size / 1024).toFixed(1) + ' KB' : 'Tidak diketahui' %>
                                                </small>
                                            </div>
                                            <a href="<%= media.file_path %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-download"></i> Download
                                            </a>
                                        </div>
                                    </div>
                                    <div class="form-text text-warning">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Upload file baru untuk mengganti file yang ada, atau biarkan kosong untuk mempertahankan file saat ini.
                                    </div>
                                <% } else { %>
                                    <div class="border rounded p-3 bg-light text-muted">
                                        <i class="bi bi-file-earmark-x me-2"></i>Tidak ada file yang diupload
                                    </div>
                                    <div class="form-text">
                                        Upload file untuk menambahkan file ke media ini.
                                    </div>
                                <% } %>
                            </div>

                            <div class="mb-3">
                                <label for="file" class="form-label">
                                    <i class="bi bi-file-earmark-arrow-up me-1"></i>Ganti File
                                </label>
                                <input type="file" class="form-control" id="file" name="file">
                                <div class="form-text">
                                    Semua jenis file didukung (Max 10MB)
                                    <% if (media.file_name) { %>
                                        <br><strong class="text-warning">Catatan:</strong> Upload file baru akan menggantikan file yang sudah ada.
                                    <% } %>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-warning">
                                    <i class="bi bi-check-circle me-1"></i>Update
                                </button>
                                <a href="/media" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left me-1"></i>Kembali
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Additional Info Card -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <i class="bi bi-info-circle me-1"></i>Informasi Tambahan
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-6">
                                <small class="text-muted">Dibuat pada:</small><br>
                                <strong><%= new Date(media.created_at).toLocaleDateString('id-ID', {
                                    year: 'numeric',
                                    month: 'long',
                                    day: 'numeric',
                                    hour: '2-digit',
                                    minute: '2-digit'
                                }) %></strong>
                            </div>
                            <div class="col-sm-6">
                                <small class="text-muted">Terakhir diupdate:</small><br>
                                <strong><%= media.updated_at ? new Date(media.updated_at).toLocaleDateString('id-ID', {
                                    year: 'numeric',
                                    month: 'long',
                                    day: 'numeric',
                                    hour: '2-digit',
                                    minute: '2-digit'
                                }) : 'Belum pernah' %></strong>
                            </div>
                        </div>
                        <% if (media.created_by) { %>
                            <div class="mt-2">
                                <small class="text-muted">Dibuat oleh:</small>
                                <strong><%= media.created_by %></strong>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
